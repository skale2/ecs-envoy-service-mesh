{
  "Parameters": {
    "MeshclusterName": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/clusterName",
      "Description": "Resolved from SSM parameter /demo-mesh/clusterName"
    },
    "MeshcapacityProvider": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/capacityProvider",
      "Description": "Resolved from SSM parameter /demo-mesh/capacityProvider"
    },
    "MeshvpcId": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/vpcId",
      "Description": "Resolved from SSM parameter /demo-mesh/vpcId"
    },
    "MeshtaskSgId": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/taskSgId",
      "Description": "Resolved from SSM parameter /demo-mesh/taskSgId"
    },
    "MeshprivateSubnets": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/privateSubnets",
      "Description": "Resolved from SSM parameter /demo-mesh/privateSubnets"
    },
    "MeshexecutionRoleArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/executionRoleArn",
      "Description": "Resolved from SSM parameter /demo-mesh/executionRoleArn"
    },
    "MeshtaskRoleArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/taskRoleArn",
      "Description": "Resolved from SSM parameter /demo-mesh/taskRoleArn"
    },
    "MeshxdsBucket": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/xdsBucket",
      "Description": "Resolved from SSM parameter /demo-mesh/xdsBucket"
    },
    "MeshhostedZoneId": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/hostedZoneId",
      "Description": "Resolved from SSM parameter /demo-mesh/hostedZoneId"
    },
    "MeshmeshDomain": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/meshDomain",
      "Description": "Resolved from SSM parameter /demo-mesh/meshDomain"
    },
    "MeshnlbDns": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/nlbDns",
      "Description": "Resolved from SSM parameter /demo-mesh/nlbDns"
    },
    "MeshnlbHostedZoneId": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/nlbHostedZoneId",
      "Description": "Resolved from SSM parameter /demo-mesh/nlbHostedZoneId"
    },
    "MeshnamespaceId": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/namespaceId",
      "Description": "Resolved from SSM parameter /demo-mesh/namespaceId"
    },
    "MeshenvoyImageUri": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/envoyImageUri",
      "Description": "Resolved from SSM parameter /demo-mesh/envoyImageUri"
    },
    "MeshregistryTable": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/registryTable",
      "Description": "Resolved from SSM parameter /demo-mesh/registryTable"
    },
    "MeshregistryWriterArn": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/demo-mesh/registryWriterArn",
      "Description": "Resolved from SSM parameter /demo-mesh/registryWriterArn"
    },
    "ServiceName": {
      "Type": "String",
      "AllowedPattern": "[a-z][a-z0-9-]{1,30}",
      "Description": "Logical mesh service name (DNS label)"
    },
    "ImageUri": {
      "Type": "String",
      "Description": "Container image URI for the application"
    },
    "AppPort": {
      "Type": "Number",
      "Default": 8080,
      "MaxValue": 65535,
      "MinValue": 1
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 1,
      "MaxValue": 200,
      "MinValue": 0
    }
  },
  "Resources": {
    "ServiceLogs205D48C6": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Join": [
            "",
            [
              "/ecs/",
              {
                "Ref": "MeshmeshDomain"
              },
              "/",
              {
                "Ref": "ServiceName"
              }
            ]
          ]
        },
        "RetentionInDays": 7
      },
      "UpdateReplacePolicy": "Delete",
      "DeletionPolicy": "Delete"
    },
    "ServiceTaskDef1922A00F": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "ContainerDefinitions": [
          {
            "Cpu": 256,
            "Environment": [
              {
                "Name": "APP_PORT",
                "Value": {
                  "Ref": "AppPort"
                }
              },
              {
                "Name": "SERVICE_NAME",
                "Value": {
                  "Ref": "ServiceName"
                }
              },
              {
                "Name": "MESH_DOMAIN",
                "Value": {
                  "Ref": "MeshmeshDomain"
                }
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              }
            ],
            "Essential": true,
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                {
                  "Fn::Join": [
                    "",
                    [
                      "curl -fsS http://localhost:",
                      {
                        "Ref": "AppPort"
                      },
                      "/health || exit 1"
                    ]
                  ]
                }
              ],
              "Interval": 5,
              "Retries": 6,
              "StartPeriod": 60,
              "Timeout": 3
            },
            "Image": {
              "Ref": "ImageUri"
            },
            "LinuxParameters": {
              "Capabilities": {},
              "InitProcessEnabled": true
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "ServiceLogs205D48C6"
                },
                "awslogs-stream-prefix": "app",
                "awslogs-region": {
                  "Ref": "AWS::Region"
                }
              }
            },
            "Memory": 256,
            "Name": "app",
            "PortMappings": [
              {
                "ContainerPort": {
                  "Ref": "AppPort"
                },
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "ExecutionRoleArn": {
          "Ref": "MeshexecutionRoleArn"
        },
        "Family": "MeshNlbServiceTemplateServiceTaskDef5173161D",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "EC2"
        ],
        "TaskRoleArn": {
          "Ref": "MeshtaskRoleArn"
        }
      }
    },
    "ServiceCloudMapService0DE797A5": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": {
          "Ref": "ServiceName"
        },
        "NamespaceId": {
          "Ref": "MeshnamespaceId"
        }
      }
    },
    "ServiceNlbD3DB596A": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Subnets": {
          "Fn::Split": [
            ",",
            {
              "Ref": "MeshprivateSubnets"
            }
          ]
        },
        "Type": "network"
      }
    },
    "ServiceNlbTargetsB69138A9": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "HealthCheckIntervalSeconds": 10,
        "HealthCheckPath": "/health",
        "HealthCheckProtocol": "HTTP",
        "HealthyThresholdCount": 2,
        "Port": {
          "Ref": "AppPort"
        },
        "Protocol": "TCP",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "10"
          }
        ],
        "TargetType": "ip",
        "UnhealthyThresholdCount": 2,
        "VpcId": {
          "Ref": "MeshvpcId"
        }
      }
    },
    "ServiceNlbListener28A43CC2": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "DefaultActions": [
          {
            "TargetGroupArn": {
              "Ref": "ServiceNlbTargetsB69138A9"
            },
            "Type": "forward"
          }
        ],
        "LoadBalancerArn": {
          "Ref": "ServiceNlbD3DB596A"
        },
        "Port": {
          "Ref": "AppPort"
        },
        "Protocol": "TCP"
      }
    },
    "ServiceNlbName04500459": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "MeshhostedZoneId"
        },
        "Name": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "ServiceName"
              },
              ".",
              {
                "Ref": "MeshmeshDomain"
              }
            ]
          ]
        },
        "ResourceRecords": [
          {
            "Fn::GetAtt": [
              "ServiceNlbD3DB596A",
              "DNSName"
            ]
          }
        ],
        "TTL": "60",
        "Type": "CNAME"
      }
    },
    "ServiceD69D759B": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": {
              "Ref": "MeshcapacityProvider"
            },
            "Weight": 1
          }
        ],
        "Cluster": {
          "Ref": "MeshclusterName"
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "EnableExecuteCommand": true,
        "HealthCheckGracePeriodSeconds": 30,
        "LoadBalancers": [
          {
            "ContainerName": "app",
            "ContainerPort": {
              "Ref": "AppPort"
            },
            "TargetGroupArn": {
              "Ref": "ServiceNlbTargetsB69138A9"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Ref": "MeshtaskSgId"
              }
            ],
            "Subnets": {
              "Fn::Split": [
                ",",
                {
                  "Ref": "MeshprivateSubnets"
                }
              ]
            }
          }
        },
        "ServiceName": {
          "Fn::Join": [
            "-",
            [
              "service",
              {
                "Ref": "ServiceName"
              }
            ]
          ]
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "ServiceCloudMapService0DE797A5",
                "Arn"
              ]
            }
          }
        ],
        "TaskDefinition": {
          "Ref": "ServiceTaskDef1922A00F"
        }
      },
      "DependsOn": [
        "ServiceCloudMapService0DE797A5",
        "ServiceNlbListener28A43CC2"
      ]
    },
    "ServiceRegistryEntry3DA38A57": {
      "Type": "Custom::MeshRegistryEntry",
      "Properties": {
        "ServiceToken": {
          "Ref": "MeshregistryWriterArn"
        },
        "Create": {
          "Fn::Join": [
            "",
            [
              "{\"service\":\"DynamoDB\",\"action\":\"putItem\",\"parameters\":{\"TableName\":\"",
              {
                "Ref": "MeshregistryTable"
              },
              "\",\"Item\":{\"name\":{\"S\":\"",
              {
                "Ref": "ServiceName"
              },
              "\"},\"port\":{\"N\":\"",
              {
                "Ref": "AppPort"
              },
              "\"},\"proxy\":{\"S\":\"nlb\"},\"address\":{\"S\":\"",
              {
                "Fn::GetAtt": [
                  "ServiceNlbD3DB596A",
                  "DNSName"
                ]
              },
              "\"}}},\"physicalResourceId\":{\"id\":\"",
              {
                "Ref": "ServiceName"
              },
              "\"}}"
            ]
          ]
        },
        "Update": {
          "Fn::Join": [
            "",
            [
              "{\"service\":\"DynamoDB\",\"action\":\"putItem\",\"parameters\":{\"TableName\":\"",
              {
                "Ref": "MeshregistryTable"
              },
              "\",\"Item\":{\"name\":{\"S\":\"",
              {
                "Ref": "ServiceName"
              },
              "\"},\"port\":{\"N\":\"",
              {
                "Ref": "AppPort"
              },
              "\"},\"proxy\":{\"S\":\"nlb\"},\"address\":{\"S\":\"",
              {
                "Fn::GetAtt": [
                  "ServiceNlbD3DB596A",
                  "DNSName"
                ]
              },
              "\"}}},\"physicalResourceId\":{\"id\":\"",
              {
                "Ref": "ServiceName"
              },
              "\"}}"
            ]
          ]
        },
        "Delete": {
          "Fn::Join": [
            "",
            [
              "{\"service\":\"DynamoDB\",\"action\":\"deleteItem\",\"parameters\":{\"TableName\":\"",
              {
                "Ref": "MeshregistryTable"
              },
              "\",\"Key\":{\"name\":{\"S\":\"",
              {
                "Ref": "ServiceName"
              },
              "\"}}},\"physicalResourceId\":{\"id\":\"",
              {
                "Ref": "ServiceName"
              },
              "\"}}"
            ]
          ]
        },
        "InstallLatestAwsSdk": false
      },
      "DependsOn": [
        "ServiceD69D759B"
      ]
    }
  },
  "Outputs": {
    "ServiceHostname": {
      "Value": {
        "Fn::Join": [
          "",
          [
            {
              "Ref": "ServiceName"
            },
            ".",
            {
              "Ref": "MeshmeshDomain"
            }
          ]
        ]
      }
    }
  }
}
